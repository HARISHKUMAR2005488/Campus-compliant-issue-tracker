# ============================================================
# Campus Complaint & Issue Tracker — AWS Environment Variables
# ============================================================
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.

# --- AWS Credentials ---
# On EC2 with an IAM Role attached: LEAVE THESE BLANK.
# boto3 will automatically use the EC2 instance profile credentials.
# Only fill these in for LOCAL development without an IAM role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- DynamoDB ---
# Table must have partition key: id (String)
DYNAMODB_TABLE=campus_tracker

# --- S3 ---
# Bucket should have Block Public Access enabled; presigned URLs are used
S3_BUCKET=campus-tracker-images

# How long presigned image URLs stay valid (seconds)
PRESIGNED_EXPIRY=3600

# --- Flask ---
PORT=5000
FLASK_DEBUG=false

# --- CORS ---
# Restrict to your EC2 domain/IP in production, e.g.:
# ALLOWED_ORIGINS=http://your-ec2-public-ip
# Leave as * for local development
ALLOWED_ORIGINS=*
